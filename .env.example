# RUN ROOM settings. Copy this file to .env (git-ignored) and uncomment what you need.
# A real environment variable with the same name wins over the .env file.

# Admin password. Without it, everyone who opens the page has full access, which is fine while
# the server only listens on this computer (127.0.0.1, the default). With it, visitors watch as
# guests and this password unlocks running code. Required for npm run dev:public / start:public.
# Use a long random value (12+ characters) before you put RUN ROOM on a network.
# RUNROOM_ACCESS_PASSWORD=

# HTTP + WebSocket port (the Vite dev proxy follows it).
# PORT=8787

# Listen address. --public or RUNROOM_PUBLIC=1 makes it 0.0.0.0 (needs the password above).
# HOST=127.0.0.1
# RUNROOM_PUBLIC=1

# Extra browser origins allowed to connect, comma separated (for example behind a reverse proxy).
# RUNROOM_ALLOWED_ORIGINS=https://office.example.com

# Set to off to switch running code off entirely (the office is then only a show).
# RUNROOM_RUN=off

# Where saved projects live (data/projects inside it).
# RUNROOM_DATA_DIR=./data

# Function call tracing: auto, monitoring (Python 3.12+), profile or off.
# RUNROOM_TRACE=auto

# Time limits in minutes: one program (time waiting for input does not count), one setup command.
# RUNROOM_RUN_TIMEOUT_MIN=60
# RUNROOM_SETUP_TIMEOUT_MIN=20

# Simulation ticks per second.
# SIM_TICK_RATE=60

# The Python 3.8+ interpreter to use (a path or a command). Default: python3, python, then py -3.
# PYTHON=python3
