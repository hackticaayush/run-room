{
  "name": "run-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RUN ROOM - a live, shared, server-simulated pixel-art hacker office.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node tools/assets/generate.mjs",
    "predev": "npm run assets",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --host --config client/vite.config.ts",
    "predev:public": "npm run assets",
    "dev:public": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server:public\" \"npm:dev:client\"",
    "dev:server:public": "tsx watch --clear-screen=false server/index.ts --public",
    "prebuild": "npm run assets && npm run check:emoji",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/index.ts --serve-client",
    "start:public": "tsx server/index.ts --serve-client --public",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "precheck": "npm run assets",
    "check": "npm run check:emoji && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "easystarjs": "^0.4.4",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
